# LLM runtime (Requesty, OpenAI-compatible)
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://requesty.ai/v1
LLM_MODEL=deepseek/deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-3-small

# Memory (Phase 2)
MEMORY_ENABLED=true
MEMORY_SHORT_TTL_MIN=60
MEMORY_VECTOR_DIR=./data/memory

# Postgres
DATABASE_URL=postgres://kubeai:kubeai@localhost:5432/kubeai?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379

# HTTP
HTTP_ADDR=:8080

# Sandbox
SANDBOX_RUNTIME=docker
SANDBOX_IMAGE=kubeai-sandbox:local
SANDBOX_CPU=1
SANDBOX_MEM_MB=1024
SANDBOX_NETWORK=none

# Demo
DEMO_REPO_PATH=./demo/repo
AGENT_TIMEOUT_MIN=30

# Workflow engine
ENGINE_CONCURRENCY=4
