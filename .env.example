# LLM runtime (Requesty, OpenAI-compatible)
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://requesty.ai/v1
LLM_MODEL=deepseek/deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-3-small

# Model router (Phase 7): logical tiers, mapped to models in your local .env
ROUTER_FAST_MODEL=provider/fast-model
ROUTER_CODING_MODEL=            # defaults to LLM_MODEL
ROUTER_REASONING_MODEL=provider/reasoning-model
ROUTER_VISION_MODEL=            # future; leave empty

# Gateways (primary defaults to REQUESTY_*; fallback enables cross-provider failover)
ROUTER_PRIMARY_URL=
ROUTER_PRIMARY_API_KEY=
ROUTER_FALLBACK_URL=
ROUTER_FALLBACK_API_KEY=

# Memory (Phase 2)
MEMORY_ENABLED=true
MEMORY_SHORT_TTL_MIN=60
MEMORY_VECTOR_DIR=./data/memory

# Postgres
DATABASE_URL=postgres://kubeai:kubeai@localhost:5432/kubeai?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379

# HTTP
HTTP_ADDR=:8080

# Sandbox
SANDBOX_RUNTIME=docker      # docker | firecracker
SANDBOX_IMAGE=kubeai-sandbox:local
SANDBOX_CPU=1
SANDBOX_MEM_MB=1024
SANDBOX_NETWORK=none

# Firecracker runtime (Phase 6) — see scripts/build-firecracker-rootfs.sh
FIRECRACKER_BINARY=./deploy/firecracker/firecracker
FIRECRACKER_KERNEL=./deploy/firecracker/vmlinux.bin
FIRECRACKER_ROOTFS=./deploy/firecracker/rootfs.ext4
FIRECRACKER_WORKDIR=./data/firecracker
FIRECRACKER_POOL=2
FIRECRACKER_PORT=5200
FIRECRACKER_VCPU=2
FIRECRACKER_MEM_MIB=1024

# Sandbox hardening (Phase 5)
SANDBOX_READ_ONLY=true        # read-only rootfs + writable /tmp tmpfs
SANDBOX_CAP_DROP=true         # drop all Linux capabilities
SANDBOX_PIDS_LIMIT=256        # fork-bomb containment
SANDBOX_USER=1000:1000        # non-root uid:gid

# Checkpointing (Phase 5)
CHECKPOINT_ENABLED=true       # resume tasks from the last tool boundary

# Demo
DEMO_REPO_PATH=./demo/repo
AGENT_TIMEOUT_MIN=30

# Workflow engine
ENGINE_CONCURRENCY=4

# Distributed workers (Phase 4)
WORKER_MODE=embedded   # embedded (single binary) or remote (separate workers)
NATS_URL=nats://localhost:4222

# Auth & orgs (Phase 10)
AUTH_ENABLED=true
ADMIN_API_KEY=adr-dev-admin

# Quotas (Phase 10)
ORG_MAX_CONCURRENT_AGENTS=3
ORG_MAX_DAILY_AGENTS=100
ORG_DAILY_COST_CAP=1.0

# Rate limiting (Phase 10)
RATE_LIMIT_PER_MIN=10

# Leadership (Phase 10) — Postgres advisory lock
LEADER_ENABLED=true

# Worker autoscaling (Phase 10) — remote mode only
WORKER_AUTOSCALE=false
WORKER_MIN=1
WORKER_MAX=8
SCALE_UP_THRESHOLD=10
SCALE_DOWN_IDLE_SEC=60
WORKER_BINARY=./bin/kubeai-worker
